  "cells": [
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "rng = np.random.default_rng(0)"
      ],
      "metadata": {
        "id": "nTcb0pG_BTCX"
      },
      "execution_count": 26,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def decay_constant(T_half):     # value of lambda\n",
        "  return np.log(2)/T_half\n",
        "\n",
        "def theory_curve(no_of_atoms, T_half, t):\n",
        "  return no_of_atoms * np.exp(-decay_constant(T_half)*t)\n",
        "\n",
        "def method1(no_of_atoms, T_half, dt, total_time):\n",
        "  lam = decay_constant(T_half)\n",
        "  p = 1 - np.exp(-lam*dt)                     # probability\n",
        "  n_left = no_of_atoms                     # no. of atoms left\n",
        "  n_steps = int(round(total_time/dt))                # no. of time slices that fit into total time i am simulating\n",
        "  counts = [n_left]\n",
        "\n",
        "  for step in range(n_steps):\n",
        "    x = rng.random(n_left)\n",
        "    decayed = (x < p).sum()\n",
        "    n_left -= decayed\n",
        "    counts.append(n_left)\n",
        "  return np.arange(n_steps + 1)*dt, np.array(counts)\n",
        "\n",
        "\n",
        "def method2(no_of_atoms, T_half, t):\n",
        "  lam = decay_constant(T_half)\n",
        "  death_times = rng.exponential(scale=1/lam, size = no_of_atoms)\n",
        "  t_scan = 90\n",
        "  alive = []\n",
        "  for time in t:\n",
        "    survived = (death_times > time).sum()\n",
        "    alive.append(survived)\n",
        "    survived_at_90 = (death_times > t_scan).sum()\n",
        "    fraction = survived_at_90 / no_of_atoms\n",
        "  theory_fraction = np.exp(-lam*t_scan)\n",
        "  return alive\n",
        "\n",
        "\n",
        "def decay_plot(t, c1, c2, theory, unit, title = ''):\n",
        "  plt.plot(t,c1, label = 'Method 1')\n",
        "  plt.plot(t,c2, label = 'Method 2')\n",
        "  plt.plot(t,theory, label = 'theory')\n",
        "  plt.xlabel(f'Time {unit}')\n",
        "  plt.ylabel('Atoms remaining')\n",
        "  plt.yscale('log')\n",
        "  plt.title(title)\n",
        "  plt.legend()\n",
        "  plt.tight_layout()\n"
      ],
      "metadata": {
        "id": "Vfg1zf3s-2AW"
      },
      "execution_count": 27,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def run_once(no_of_atoms, T_half, t_check):\n",
        "    lam = np.log(2) / T_half                      ,
        "    death_times = rng.exponential(scale=1 / lam, size=no_of_atoms)\n",
        "    return (death_times > t_check).sum()\n",
        "\n",
        "def noise_experiment(T_half, t_check, sizes, n_repeats=200, unit=\"s\"):\n",
        "    lam = np.log(2) / T_half\n",
        "    means, stds, rel = [], [], []\n",
        "\n",
        "    for no_of_atoms in sizes:\n",
        "        results = []\n",
        "        for _ in range(n_repeats):\n",
        "            results.append(run_once(no_of_atoms, T_half, t_check))\n",
        "\n",
        "        # statistics after collecting all repetitions for this size\n",
        "        means.append(np.mean(results))\n",
        "        stds.append(np.std(results))\n",
        "        rel.append(np.std(results) / np.mean(results))\n",
        "        print(f\"N0 = {no_of_atoms:>6}: mean = {means[-1]:9.1f}, std = {stds[-1]:7.1f}, \"\n",
        "              f\"relative scatter = {100 * rel[-1]:.2f} %\")\n",
        "\n",
        "    slope = np.polyfit(np.log10(sizes), np.log10(rel), 1)[0]\n",
        "    print(f\"\\nFitted slope = {slope:.2f}  (theory: -0.5)\")\n",
        "\n",
        "    q = np.exp(-lam * t_check)                              # fraction surviving at t_check\n",
        "    theory_rel = np.sqrt((1 - q) / (q * np.array(sizes))),
        "\n",
        "    plt.figure(figsize=(6, 4.5))\n",
        "    plt.loglog(sizes, rel, \"o-\", label=\"Simulation\")\n",
        "    plt.loglog(sizes, theory_rel, \"--\", label=\"Theory\")\n",
        "    plt.xlabel(\"Starting number of atoms, $N_0$\")\n",
        "    plt.ylabel(f\"Relative scatter at t = {t_check} {unit}\")\n",
        "    plt.legend()\n",
        "    plt.grid(alpha=0.3, which=\"both\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "    return means, stds, rel\n",
        "\n",
        "sizes = [100, 1000, 10000, 100000]\n",
        "means, stds, rel = noise_experiment(T_half=10, t_check=10, sizes=sizes, n_repeats=200, unit=\"s\")"
      ],
